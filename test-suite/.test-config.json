{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "type": "object",
  "properties": {
    "description": { "type": "string" },
    "tests": {
      "type": "array",
      "items": { "$ref": "#/$defs/TestSuite" }
    }
  },
  "required": ["tests"],
  "$defs": {
    "TestSuite": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/TestCase" }
        }
      },
      "required": ["name", "cases"]
    },
    "TestCase": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "sup": {
          "oneOf": [
            { "$ref": "https://json-schema.org/draft/2020-12/schema" },
            {
              "type": "array",
              "items": {
                "$ref": "https://json-schema.org/draft/2020-12/schema"
              }
            }
          ]
        },
        "sub": {
          "oneOf": [
            { "$ref": "https://json-schema.org/draft/2020-12/schema" },
            {
              "type": "array",
              "items": {
                "$ref": "https://json-schema.org/draft/2020-12/schema"
              }
            }
          ]
        },
        "result": {
          "oneOf": [
            { "const": true, "title": "Valid" },
            { "const": false, "title": "Invalid no error message" },
            { "type": "string", "title": "Invalid with error message" }
          ]
        }
      },
      "required": ["sup", "sub", "result"]
    }
  }
}
